# エムスタ - 環境変数サンプル
# 本ファイルをコピーして .env.local を作成してください

# ===== サイト全体 =====
# 本番URL (OGP / 構造化データ / 絶対URLなどで使用)
NEXT_PUBLIC_SITE_URL=https://msta.app
# production / preview / development。production以外ではrobotsで全ページdisallow
NEXT_PUBLIC_SITE_ENV=development

# ===== Primary CTA: 2週間無料トライアルの遷移先 =====
NEXT_PUBLIC_SIGNUP_URL=https://dashboard.msta-app.com/

# ===== Spirカレンダー (各ページのカテゴリ別CTA) =====
# 一般相談 (互換のため SPIR_URL も読まれます)
NEXT_PUBLIC_SPIR_GENERAL_URL=https://spir.app/your-link
# オフィシャル制作相談
NEXT_PUBLIC_SPIR_OFFICIAL_URL=https://spir.app/official
# 3hパック相談
NEXT_PUBLIC_SPIR_3H_URL=https://spir.app/3h
# エムスタFull相談
NEXT_PUBLIC_SPIR_FULL_URL=https://spir.app/full
# パートナー相談
NEXT_PUBLIC_SPIR_PARTNER_URL=https://spir.app/partner

# ===== Keystatic CMS =====
# 開発環境 (NODE_ENV=development) では下記すべて未設定でも動作します
# (ローカルファイルシステムに直接読み書きされます)
#
# 本番 / staging (Cloudflare Pages 等) で GitHub をストレージにする場合のみ設定:
# 1. GitHub Settings → Developer settings → OAuth Apps で新規アプリ作成
#    - Homepage URL:               https://<本番ドメイン>
#    - Authorization callback URL: https://<本番ドメイン>/api/keystatic/github/oauth/callback
# 2. KEYSTATIC_SECRET は `openssl rand -hex 32` 等で生成したランダム32桁以上の文字列
# 3. リポジトリに Keystatic GitHub App を connect (/keystatic 初回アクセス時のウィザード)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
KEYSTATIC_GITHUB_REPO_OWNER=develop-r117
KEYSTATIC_GITHUB_REPO_NAME=msta-lp

# ===== サーバ側 (パートナー資料DLメール送信) =====
# Resend APIキー (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
# 送信元アドレス (Resend上で認証済みドメインのもの)
RESEND_FROM=エムスタ <noreply@msta.app>
# 申込者に送るパートナー資料PDFのURL
PARTNER_DOC_URL=https://example.com/partner.pdf
# 社内通知の送信先 (任意)
NOTIFY_TO=team@msta.app
